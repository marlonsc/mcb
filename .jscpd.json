{
  "//": "jscpd configuration for the MCB FLEXT workspace. Detects code duplication across source trees, scoped to productive code only.",
  "absolute": true,
  "no-tips": true,
  "no-colors": true,
  "mode": "strict",
  "ignore": [
    "**/__pycache__/**",
    "**/target/**",
    "**/*.pyc",
    "**/*.bak",
    "**/*.tmp",
    "**/*.orig",
    "**/.venv/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.eggs/**",
    "**/__init__.py",
    "**/.github/**",
    "**/.claude/**",
    "**/.agents/**",
    "**/.cursor/**",
    "**/.codex/**",
    "**/.beads/**",
    "**/skills/**",
    "Makefile",
    "LICENSE.md",
    "**/fixtures/rustlings/**",
    "**/tests/golden/**",
    "**/tests/e2e/**",
    "**/tests/fixtures/**",
    "**/tests/integration/**",
    "**/tests/unit/**",
    "**/crates/*/tests/**",
    "docs/adr/archive/**",
    "**/sample_codebase/**",
    "docs/adr/003-unified-provider-architecture.md",
    "docs/adr/012-di-strategy-two-layer-approach.md",
    "docs/adr/024-simplified-dependency-injection.md",
    "docs/adr/028-advanced-code-browser-v020.md",
    "docs/adr/032-agent-quality-domain-extension.md",
    "docs/adr/036-enforcement-policies.md",
    "docs/architecture/**",
    "docs/modules/**",
    "docs/beads-sql-schema.sql"
  ],
  "reporters": ["console"],
  "min-lines": 15,
  "threshold": 1,
  "output": "/tmp/jscpd-report"
}
