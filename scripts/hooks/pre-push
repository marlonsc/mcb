#!/usr/bin/env bash
# Installed by `make setup WHAT=hooks`. Runs the canonical full gate before
# push, then preserves Beads hook processing when available.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Hooks inherit GIT_DIR/GIT_WORK_TREE from the invoking git process; leaked
# vars redirect fixture commits into this repository (they must hit temp repos).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR || true
[ -f scripts/lib/mcb.sh ] || exit 0
make check WHAT=all
if command -v bd >/dev/null 2>&1; then
  exec bd hooks run pre-push "$@"
fi
