#!/usr/bin/env bash
# Installed by `make setup WHAT=hooks`. Runs the canonical commit gates without
# bypassing hooks or calling removed Make targets.
# guard runs in --staged mode so it blocks NEW violations in this commit, not
# the retroactive baseline; `make guard` (full tree) is the CI/manual scan.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Hooks inherit GIT_DIR/GIT_WORK_TREE from the invoking git process; leaked
# vars redirect fixture commits into this repository (they must hit temp repos).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR || true
[ -f scripts/lib/mcb.sh ] || exit 0
echo "→ guard (staged)…";   bash scripts/lib/mcb.sh guard --staged
echo "→ lint…";             make check WHAT=lint
echo "→ validate (quick)…"; make check WHAT=validate QUICK=1
echo "✓ pre-commit passed"
