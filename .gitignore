# Agent hooks and machine-local config (runtime state, never source)
.github/hooks/
*/.hooks.json.agents-governance.json
.claude/*.agents-governance.json
.gemini/*.agents-governance.json
.claude/settings.local.json

# Private local config overrides
/config/codegen-overrides.local.yaml

# Gas City skill projections (runtime state, never source)
.agents/skills/.gc-skill-ownership.json
.agents/skills/core.gc-*
.agents/skills/gascity.*
.agents/skills/gc.*
.claude/skills/.gc-skill-ownership.json
.claude/skills/core.gc-*
.claude/skills/gascity.*
.claude/skills/gc.*
