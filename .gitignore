# TRACK: Beads team config; keep Dolt data, runtime state, and JSONL exports local.
!.beads/
.beads/*
!.beads/config.yaml
!.beads/metadata.json
!.beads/identity.toml

# mise native dependency graphs
/.mise-lock-transaction.lock
!/.mise/
/.mise/*
!/.mise/locks/
!/.mise/locks/**
/.mise/locks/*.local/
/mise*.local.lock
/.mise*.local.lock

# BLOCK: AI/Agent Local Data (NEVER track these)
.claude/local/
.claude/history/
.claude/todos/
.claude/statsig/
.claude/projects/
.claude/shell-snapshots/
.claude/worktrees/
