# =============================================================================
# MCB .gitignore — comprehensive protection against cruft
# =============================================================================

# ---------------------------------------------------------------------------
# Rust build artifacts
# ---------------------------------------------------------------------------
target/
dist/
exports/
*.rlib

# ---------------------------------------------------------------------------
# IDE / Editor files
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# OS files
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# AI / Agent — runtime data (never version-controlled)
# ---------------------------------------------------------------------------
/context/
docs/context/
docs/contexts/
.claude/
.planning/
.beads/
.oc-memory/
.sisyphus/
.agent/
openspec/
thoughts/
oracle/
.oracle/
**/oracle/
**/.oracle/
GEMINI.md
.check_*
.test_*
.mcp.json

# Session artifacts (auto-generated)
CONTINUATION_*.md
.PROTOCOL_*.md

# GitHub AI prompts/skills (local only)
.agents/
.github/prompts/
.github/skills/

# ---------------------------------------------------------------------------
# AI / Agent — tool-specific runtime exclusions
# ---------------------------------------------------------------------------

# Aider: ignore runtime data, keep .aider.conf.yml
.aider.chat.history.md
.aider.input.history
.aider.tags.*

# Cursor: ignore runtime data, keep .cursor/rules/
.cursor/*
!.cursor/rules/

# OpenCode: ignore runtime (node_modules, bun.lock), no config to track
.opencode/
opencode.jsonc

# Codex: ignore runtime cache
.codex/

# Continue.dev: ignore runtime data, keep .continue/rules/
.continue/*
!.continue/rules/

# Arbor: ignore cache/runtime, keep config.json
.arbor/cache/
arbor-graph.json

# ---------------------------------------------------------------------------
# AI / Agent — tracked config files (DO NOT add these to ignore)
# ---------------------------------------------------------------------------
# AGENTS.md          — agent configuration index
# CLAUDE.md          — single source of truth
# CONVENTIONS.md     — Aider conventions pointer
# codex.md           — Codex pointer
# .clinerules        — Cline pointer
# .windsurfrules     — Windsurf pointer
# .aider.conf.yml    — Aider config
# .cursor/rules/     — Cursor rules
# .continue/rules/   — Continue.dev rules
# .gemini/           — Gemini Code Assist (config.yaml + styleguide.md)
# .github/copilot-instructions.md — GitHub Copilot
# .arbor/config.json — Arbor config

# ---------------------------------------------------------------------------
# Reports, analysis output, temporary scripts (NEVER commit these)
# ---------------------------------------------------------------------------
# Markdown reports generated by tools/agents
CHECKS_REPORT.md
CHECK_FIXES_SUMMARY.md
CRITICAL_CHECKS.md
IMPLEMENTATION_SUMMARY.md
OSV_SCANNER_WARNINGS.md
QUALITY_ANALYSIS_GUIDE.md
REFACTORING_PLAN.md
REFACTORING_SUMMARY.md
SMELL_ANALYSIS_SUMMARY.md

# JSON data dumps
checks_data.json
critical_checks.json

# Throwaway Python/shell scripts
count_issues.py
extract_issues.py
fix_cache.py
fix_checkout.py
fix_lint.py
list_artipacked.py
list_cache.py
list_issues.py
list_unpinned.py

# Catch-all patterns for ad-hoc reports and scripts
*_REPORT.md
*_SUMMARY.md
*_ANALYSIS*.md
*_PLAN.md
*_GUIDE.md
*_WARNINGS.md
*_output*.txt
*_report*.txt
*_fix*.txt
*_final*.txt

# ---------------------------------------------------------------------------
# Log files
# ---------------------------------------------------------------------------
*.log
.logs/
*.txt
!LICENSE.txt
mcb.20??-??-??
**/mcb.20??-??-??
.*_log
.final_tests_log

# ---------------------------------------------------------------------------
# Test artifacts
# ---------------------------------------------------------------------------
test-results/
playwright-report/
e2e/screenshots/
*.profraw
coverage/
*.proptest-regressions

# ---------------------------------------------------------------------------
# Backup / temporary / generated files
# ---------------------------------------------------------------------------
*.bak
*.bak?
*.bak.*
*.bkp
*.backup
*.backup*
*.disabled
*.archive
*.archived
*.obsolete
*.new
*.old
*.broken
*.clean
*.removed
*.tmp
*.temp
*.pid
*.sarif

# ---------------------------------------------------------------------------
# Database files
# ---------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------------
.env
.env.local
.envrc
.direnv/

# ---------------------------------------------------------------------------
# Package managers / caches
# ---------------------------------------------------------------------------
node_modules/
.fastembed_cache/
.cache/
__pycache__/
*.pyc
*.pyo
.cargo/

# ---------------------------------------------------------------------------
# Documentation build
# ---------------------------------------------------------------------------
book/
docs/generated/
docs/reports/
docs/plans/
!docs/adr/archive/*
docs/**/*backup*
docs/**/*bak*
docs/**/*old*
reports/

# ---------------------------------------------------------------------------
# Coverage / profiling
# ---------------------------------------------------------------------------
.coverage/
*.lcov
*.perf
perf.data*
data/

# ---------------------------------------------------------------------------
# CI/CD artifacts
# ---------------------------------------------------------------------------
.github/workflows/*.log

# ---------------------------------------------------------------------------
# Fuzzing / Benchmarks
# ---------------------------------------------------------------------------
fuzz/artifacts/
fuzz/corpus/
benchmark_results/

# ---------------------------------------------------------------------------
# Generated / reference
# ---------------------------------------------------------------------------
reference/
*.lst

# ---------------------------------------------------------------------------
# Quality tool directories
# ---------------------------------------------------------------------------
.ruff_cache/
.mypy_cache/
.pytest_cache/
.venv/

# ---------------------------------------------------------------------------
# Code-intelligence index caches (local only)
# ---------------------------------------------------------------------------
.scope/
.serena/

# ---------------------------------------------------------------------------
# Archived files (moved out of project, kept locally for reference)
# ---------------------------------------------------------------------------
archive/
