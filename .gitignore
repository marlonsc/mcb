**/*.swp
**/*.swo
**/*~
**/.*.sw?
# OS files inside allowed directories
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
# Temporary and log files inside allowed directories
**/*.log
**/*.tmp
**/*.temp
**/tmp/
**/temp/
